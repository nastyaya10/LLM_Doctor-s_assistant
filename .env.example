API_KEY=your_api_key
BASE_URL=https://ai.api.cloud.yandex.net/v1
MODEL=yandexgpt/rc
FOLDER_ID=your_folder_id

STT_API_KEY=your_openai_or_compatible_stt_key
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
# STT_PROVIDER=openai
# Для Yandex SpeechKit можно не задавать STT_*: при BASE_URL с Yandex будет использован API_KEY/FOLDER_ID.
# STT_PROVIDER=yandex
# STT_LANG=ru-RU
# STT_SAMPLE_RATE=16000

RAG_DB_DIR=db
RAG_NEIGHBOR_RADIUS=1
RAG_MAX_CONTEXT_CHARS=30000
RAG_USE_RERANKER=1
LOG_RERANKER_IO=1
LOG_RAG_CONTEXT=1

HOST=0.0.0.0
PORT=8000
OPEN_BROWSER=0
